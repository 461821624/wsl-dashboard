import { Theme, AppI18n, LayoutConstants, DockerContainer } from "../theme.slint";
import { CustomButton } from "form_widgets.slint";

component CopyRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    callback copy_text(string);
    spacing: 8px;
    height: max(26px, value_text.preferred-height);
    Text {
        text: root.label;
        width: 64px;
        color: Theme.text_secondary;
        font-family: Theme.default_font;
        font-size: 12px * LayoutConstants.font-scale;
        vertical-alignment: center;
    }
    value_text := Text {
        text: root.value == "" ? "—" : root.value;
        horizontal-stretch: 1;
        min-width: 0px;
        color: Theme.text_primary;
        font-family: Theme.default_font;
        font-size: 12px * LayoutConstants.font-scale;
        wrap: word-wrap;
        vertical-alignment: center;
    }
    CustomButton {
        text: AppI18n.t("docker.copy", [AppI18n.version]);
        height: 26px;
        enabled: root.value != "";
        clicked => { root.copy_text(root.value); }
    }
}

export component DockerContainerCard inherits Rectangle {
    in property <DockerContainer> container;
    in property <bool> enabled: true;
    in property <bool> expanded: false;
    in property <string> operation;
    callback action(string, string);
    callback toggle_details();
    callback copy_text(string);
    property <color> state_color: container.state == "running" ? Theme.icon_color_success :
        (container.state == "restarting" || container.state == "paused") ? Theme.icon_color_warning : Theme.text_secondary;
    background: Theme.card_bg;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.operation != "" ? Theme.accent : Theme.border_color;
    height: card.preferred-height;
    card := VerticalLayout {
        padding: 10px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.container.name;
                horizontal-stretch: 1;
                min-width: 0px;
                color: Theme.text_primary;
                font-family: Theme.default_font;
                font-size: 14px * LayoutConstants.font-scale;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }
            Rectangle {
                height: 22px;
                width: state_text.preferred-width + 16px;
                border-radius: 11px;
                background: root.state_color.with-alpha(0.12);
                state_text := Text {
                    text: AppI18n.t("docker.state_" + root.container.state, [AppI18n.version]);
                    color: root.state_color;
                    font-family: Theme.default_font;
                    font-size: 11px * LayoutConstants.font-scale;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.container.image;
            color: Theme.text_secondary;
            font-family: Theme.default_font;
            font-size: 12px * LayoutConstants.font-scale;
            overflow: elide;
            wrap: no-wrap;
        }
        if root.container.ports != "": Text {
            text: AppI18n.t("docker.ports", [AppI18n.version]) + ": " + root.container.ports;
            color: Theme.text_secondary;
            font-family: Theme.default_font;
            font-size: 12px * LayoutConstants.font-scale;
            overflow: elide;
            wrap: no-wrap;
        }
        HorizontalLayout {
            spacing: 6px;
            if root.container.state == "exited" || root.container.state == "created": CustomButton {
                text: AppI18n.t("docker.start", [AppI18n.version]);
                height: 28px;
                enabled: root.enabled;
                clicked => { root.action("start", root.container.id); }
            }
            if root.container.state == "running" || root.container.state == "restarting": CustomButton {
                text: AppI18n.t("docker.stop", [AppI18n.version]);
                height: 28px;
                enabled: root.enabled;
                clicked => { root.action("stop", root.container.id); }
            }
            if root.container.state == "running" || root.container.state == "restarting": CustomButton {
                text: AppI18n.t("docker.restart", [AppI18n.version]);
                height: 28px;
                enabled: root.enabled;
                clicked => { root.action("restart", root.container.id); }
            }
            CustomButton {
                text: AppI18n.t("docker.logs_button", [AppI18n.version]);
                height: 28px;
                enabled: root.enabled;
                clicked => { root.action("logs", root.container.id); }
            }
            CustomButton {
                text: AppI18n.t(root.expanded ? "docker.collapse" : "docker.details", [AppI18n.version]);
                height: 28px;
                clicked => { root.toggle_details(); }
            }
            Text {
                text: root.operation != "" ? root.operation : root.container.status;
                color: root.operation != "" ? Theme.accent : Theme.text_secondary;
                font-family: Theme.default_font;
                font-size: 11px * LayoutConstants.font-scale;
                horizontal-stretch: 1;
                min-width: 0px;
                overflow: elide;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
        if root.expanded: VerticalLayout {
            spacing: 6px;
            Rectangle { height: 1px; background: Theme.border_color; }
            CopyRow {
                label: AppI18n.t("docker.name", [AppI18n.version]);
                value: root.container.name;
                copy_text(text) => { root.copy_text(text); }
            }
            CopyRow {
                label: "ID";
                value: root.container.id;
                copy_text(text) => { root.copy_text(text); }
            }
            CopyRow {
                label: AppI18n.t("docker.image", [AppI18n.version]);
                value: root.container.image;
                copy_text(text) => { root.copy_text(text); }
            }
            CopyRow {
                label: AppI18n.t("docker.ports", [AppI18n.version]);
                value: root.container.ports;
                copy_text(text) => { root.copy_text(text); }
            }
        }
    }
}
